#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin
export PATH

if [ "$(id -u)" -ne 0 ]; then
  echo "This script must be run as root." >&2
  exit 1
fi

DEST="/usr/local/etc/blocked-hosts"
TMP="$(mktemp -t blocked-hosts.XXXXXX)"
trap 'rm -f "$TMP"' EXIT
trap 'exit 1' INT TERM

install -d -m 0755 /usr/local/etc

cd /
sudo -u nobody /bin/sh -c '
  set -eu
  RAW="$(mktemp /tmp/blocked-hosts.raw.XXXXXX)"
  trap "rm -f \"\$RAW\"" EXIT
  trap "exit 1" INT TERM
  curl -q --silent --show-error --fail --max-time 300 "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts" > "$RAW"
  tr -d "\r" < "$RAW" \
  | awk "/^0\\.0\\.0\\.0[[:space:]]/ {print \$2}" \
  | grep -E "^[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?(\\.[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?)*\$" \
  | sort -u
' > "$TMP"

if [ ! -s "$TMP" ]; then
  echo "No hostnames downloaded, keeping $DEST." >&2
  exit 1
fi

printf '%s\n' '*.ingest.sentry.io' >> "$TMP"
sort -u "$TMP" -o "$TMP"

install -m 0644 -o root -g wheel "$TMP" "$DEST"

sys_type="$(uname -s 2>/dev/null)"
if [ "$sys_type" = "FreeBSD" ]; then
  service dnscrypt-proxy reload
elif [ "$sys_type" = "Linux" ]; then
  systemctl restart dnscrypt-proxy
elif [ "$sys_type" = "Darwin" ]; then
  if current="$(cd /opt/homebrew/opt/dnscrypt-proxy 2>/dev/null && pwd -P)"; then
    for keg in /opt/homebrew/Cellar/dnscrypt-proxy/*; do
      [ "$keg" = "$current" ] || rm -rf "$keg"
    done
  fi
  for plist in /Library/LaunchDaemons/*dnscrypt-proxy*.plist; do
    [ -f "$plist" ] || continue
    launchctl kickstart -k "system/$(/usr/bin/plutil -extract Label raw -o - "$plist")"
  done
else
  echo "Unknown system type, could not reload dnscrypt-proxy: $sys_type"
  exit 1
fi

exit 0
